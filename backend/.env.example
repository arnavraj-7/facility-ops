# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/facility_ops

# Redis connection string (sessions + future queues)
REDIS_URL=redis://127.0.0.1:6379

# Must be at least 32 characters
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Frontend origin (CORS + email links)
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── AI triage microservice (optional) ───────────────────────────────────
# If the Python service is unreachable, tickets fall back to a heuristic router.
AI_ENABLED=true
AI_MICROSERVICE_URL=http://127.0.0.1:8000/api/ai

# ── Email alerts (optional — logged to console when unset) ───────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
MAIL_FROM=Facility Ops <no-reply@facility-ops.local>

# ── SMS alerts via Twilio (optional — logged to console when unset) ──────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+10000000000
