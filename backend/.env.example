# Copy to .env and fill in. `cp .env.example .env`

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9000

# MongoDB. Local:  mongodb://127.0.0.1:27017/facility_ops
# Atlas:           mongodb+srv://<user>:<pass>@<cluster>/facility_ops?retryWrites=true&w=majority
# Remember the /facility_ops path segment — without it everything lands in
# the default "test" database.
MONGO_URI=mongodb://127.0.0.1:27017/facility_ops

# ── Sessions ────────────────────────────────────────────────────────────
# Redis is the session store. It is the ONLY containerised dependency:
#   docker compose up -d redis
# If it is unreachable the server logs a warning and falls back to an
# in-memory store, so the app still boots on a machine without Docker.
# Sessions then don't survive a restart and don't work across instances.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Frontend origin (CORS)
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── Triage engine ───────────────────────────────────────────────────────
# false → the built-in keyword triage engine runs in-process (no Python, no
#         API key, no network call). This is the default.
# true  → call the FastAPI/LangGraph service for Gemini-backed triage. If it
#         is unreachable the backend automatically falls back to the built-in
#         engine, so raising a ticket never fails on it.
AI_ENABLED=false
AI_MICROSERVICE_URL=http://127.0.0.1:8000/api/ai

# ── Alerts ──────────────────────────────────────────────────────────────
# Alerts are delivered in-app: a Notification document plus a live
# Server-Sent-Events push. There is no SMTP, no SMS provider, no third-party
# service and no email-verification flow anywhere in this project.
# ALERTS_LOG mirrors each alert to the server log so it is visible in a demo.
ALERTS_LOG=true
